# Cloudinary — OBLIGATOIRE sur Render pour conserver les images
#
# Dashboard Cloudinary → Product environment credentials :
#   - Cloud name     → CLOUDINARY_CLOUD_NAME   (ex. dxyz123abc)
#   - API Key        → CLOUDINARY_API_KEY      (chiffres, ex. 123456789012345)
#   - API Secret     → CLOUDINARY_API_SECRET   (longue chaîne aléatoire)
#
# NE PAS inverser Cloud name et API Key !
# NE PAS mettre d'espaces ni de guillemets dans les valeurs Render.
#
CLOUDINARY_CLOUD_NAME=gicossarl
CLOUDINARY_API_KEY=492352533934195
CLOUDINARY_API_SECRET=n2OnIR1zlYaMZkLH6pazrLO_7AI
# Alternative (une seule variable) :
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
