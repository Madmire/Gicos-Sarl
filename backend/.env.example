# Neon PostgreSQL — projet gicossarl
# Org: org-divine-cherry-87647174 | Project: dark-frog-14375888 | Branch: production
# DB: gicos_data
#
# Copier vers backend/.env et renseigner les secrets (ne jamais committer .env)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/gicos_data?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/gicos_data?sslmode=require

# JWT (générer une clé longue et aléatoire en prod)
SECRET_KEY=change-me-in-production

# Frontend Vercel (virgules si plusieurs)
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# Cloudinary (Dashboard → API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Alternative : CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
